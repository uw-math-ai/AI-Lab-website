{
	"name": "math-ai-website",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"build:ai-lab": "BASE_PATH=/AI-Lab-website vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && npm run test:content",
		"test:content": "node --test tests/content.test.mjs",
		"test:site": "node --test tests/site-content.test.mjs tests/content-rendering.test.mjs",
		"verify:ai-lab": "npm run check && npm run build:ai-lab && npm run test:site"
	},
	"devDependencies": {
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.50.2",
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"@types/node": "^25.9.1",
		"markdown-it": "^15.0.1",
		"parse5": "^8.0.1",
		"svelte": "^5.51.0",
		"svelte-check": "^4.4.2",
		"typescript": "^5.9.3",
		"vite": "^7.3.1",
		"yaml": "^2.9.0",
		"zod": "^4.5.4"
	}
}
